# Optional override for the public GitHub repository URL. Forks should use their own repository.
# This value is bundled into the frontend. Never put a token or secret here.
# Leave the value empty to hide GitHub links.
VITE_REPOSITORY_URL=https://github.com/honglinz07/proudlypaid

# Public canonical HTTPS origin used for metadata and the generated sitemap.
# Forks should use their own deployed hostname.
VITE_SITE_URL=https://www.proudlypaid.com
