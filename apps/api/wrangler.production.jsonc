{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "proudlypaid",
  "send_metrics": false,
  "upload_source_maps": true,
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "proudlypaid.com",
      "custom_domain": true,
      "zone_id": "6deac45df139b1ef69c60e1f42ffdfa5"
    },
    {
      "pattern": "www.proudlypaid.com",
      "custom_domain": true,
      "zone_id": "6deac45df139b1ef69c60e1f42ffdfa5"
    }
  ],
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "proudlypaid-catalog",
      "database_id": "bb6084b6-08ab-4ca9-99ba-46664c607b93",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
